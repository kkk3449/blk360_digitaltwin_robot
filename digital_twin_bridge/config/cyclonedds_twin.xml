<?xml version="1.0" encoding="UTF-8"?>
<!--
  digital_twin_bridge 전용 CycloneDDS 설정.

  목적: 트윈 브릿지 프로세스가
    (a) 같은 호스트에서 도는 기존 자율주행 스택(192.168.10.66 인터페이스 바인딩)과
    (b) 다른 PC 의 IsaacSim(192.168.31.135, ammr20_test wifi)
  양쪽 모두와 통신하도록 한다.

  ※ 기존 /root/cyclonedds.xml 은 건드리지 않는다. 이 파일은 브릿지 실행 시에만
     CYCLONEDDS_URI 로 지정되어 사용된다. (실행 중 자율주행에 영향 없음)

  전제: ROS_DOMAIN_ID=56, RMW_IMPLEMENTATION=rmw_cyclonedds_cpp 는 동일하게 유지.
        IsaacSim PC 도 반드시 DOMAIN 56 + CycloneDDS 로 맞춰야 한다.
-->
<CycloneDDS xmlns="https://cdds.io/config"
            xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
            xsi:schemaLocation="https://cdds.io/config https://raw.githubusercontent.com/eclipse-cyclonedds/cyclonedds/master/etc/cyclonedds.xsd">
  <Domain Id="any">
    <General>
      <Interfaces>
        <!-- 로봇 내부망(기존 스택과 동일) -->
        <NetworkInterface address="192.168.10.66" multicast="default"/>
        <!-- ammr20_test wifi (IsaacSim 과 연결되는 망) -->
        <NetworkInterface address="192.168.31.56" multicast="default"/>
      </Interfaces>
      <MaxMessageSize>64 kB</MaxMessageSize>
    </General>
    <Discovery>
      <Peers>
        <!-- 같은 호스트의 기존 스택(192.168.10.66 바인딩)을 유니캐스트로 발견 -->
        <Peer address="127.0.0.1"/>
        <Peer address="192.168.10.66"/>
        <Peer address="192.168.31.56"/>
        <!-- ===== IsaacSim PC ===== -->
        <Peer address="192.168.31.135"/>
      </Peers>
      <LeaseDuration>30 s</LeaseDuration>
      <SPDPInterval>10 s</SPDPInterval>
      <ParticipantIndex>auto</ParticipantIndex>
    </Discovery>
    <Internal>
      <SocketReceiveBufferSize min="2 MiB" max="4 MiB"/>
      <SocketSendBufferSize min="2 MiB" max="4 MiB"/>
      <MaxQueuedRexmitMessages>500</MaxQueuedRexmitMessages>
      <MaxQueuedRexmitBytes>2 MiB</MaxQueuedRexmitBytes>
    </Internal>
  </Domain>
</CycloneDDS>
